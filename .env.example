# ---------------------------------------------------------------------------
# Copy this file to ".env" for local testing:  copy .env.example .env
# On GitHub, set these same names under Settings -> Secrets and variables -> Actions
# ---------------------------------------------------------------------------

# --- OpenAI (ChatGPT API) ---------------------------------------------------
# From https://platform.openai.com/api-keys  ->  Create new secret key
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Defaults to gpt-5.4.
# Cheaper alternatives: gpt-5.4-mini, gpt-6-luna, gpt-4.1, gpt-4o-mini
# Run "node scripts/list-models.mjs" to list everything your key can reach.
# OPENAI_MODEL=gpt-5.4

# Optional. Only needed if you use a compatible gateway instead of OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Reasoning models ignore or reject some of these.
# Set OPENAI_TEMPERATURE=none to leave the parameter out of the request entirely.
# OPENAI_TEMPERATURE=0.9
# OPENAI_REASONING_EFFORT=low
# OPENAI_MAX_TOKENS=800

# --- X (Twitter) API --------------------------------------------------------
# From https://console.x.com -> your App -> "Keys and tokens"
#
# You need FOUR values, all from that one page. This is "OAuth 1.0a User Context".
#
#   Portal field          ->  variable below
#   ---------------------     ------------------------
#   API Key               ->  X_API_KEY
#   API Key Secret        ->  X_API_SECRET
#   Access Token          ->  X_ACCESS_TOKEN
#   Access Token Secret   ->  X_ACCESS_TOKEN_SECRET
#
# DO NOT use the "Bearer Token" on that page. It is application-only
# authentication: it identifies your APP, not your account, and it CANNOT create
# posts. X only accepts it on read-only endpoints. Posting will always fail with
# it, no matter how correct it looks.
#
# IMPORTANT (1): set App permissions to "Read and Write" under "User
# authentication settings" and SAVE, before generating the Access Token and
# Secret. A token created while the app was read-only cannot post, and 401s.
#
# IMPORTANT (2): the app must also live INSIDE A PROJECT. A "Standalone App"
# gets an HTTP 403 on every single v2 call (reason "client-not-enrolled"), no
# matter how correct these four values are.

X_API_KEY=your_api_key
X_API_SECRET=your_api_key_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_TOKEN_SECRET=your_access_token_secret

# Optional, rarely needed. This is an OAuth 2.0 USER token, which is a totally
# different thing from the Bearer Token above. They expire in about two hours,
# so they are unsuitable for a scheduled daily job. OAuth 1.0a is the right
# choice for automation. Leave this blank.
# X_OAUTH2_USER_TOKEN=

# --- Posting behaviour (all optional) --------------------------------------
# Post without actually publishing (true/false)
DRY_RUN=false
# Hard character limit for a single post
MAX_CHARS=280
# Probability (0 to 1) that a post carries a link. 0 = never, which is the
# default: a link post costs $0.20 instead of $0.015 and X suppresses its reach.
LINK_CHANCE=0
# How many times a day the bot may publish. The workflow fires at 08:00, 17:00,
# and 20:00 IST, so 3 means one post per slot.
POSTS_PER_DAY=3
# Quiet period after a post, in minutes. Stops a retried or manually triggered
# run from posting twice in the same slot. Keep it well below the gap between slots.
MIN_GAP_MINUTES=30
# Skip the daily limit and the minimum gap
# FORCE=false

# --- Brand details used in the prompt --------------------------------------
BRAND_NAME=InsuranceMentors.in
BRAND_SITE=https://www.insurancementors.in
BRAND_WHATSAPP=https://wa.me/918096769690
# Your X handle without the @, e.g. InsuranceMentors
BRAND_HANDLE=
